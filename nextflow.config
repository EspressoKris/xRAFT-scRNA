// nextflow.config

params {
    samplesheet           = "${projectDir}/data/sample_sheet.csv"

    // Which single-cell object(s) to build: 'seurat', 'scanpy' or 'both'
    output_format         = "both"

    cellranger_libraries  = "/project/ANGEL/shared/Pipeline_test2/Data/CellRanger_libraries"
    cellranger_results    = "/project/ANGEL/shared/Pipeline_test2/Data/CellRanger_results"
    souporcell_results    = "/project/ANGEL/shared/Pipeline_test2/Data/Souporcell_results"
    cellbender_results    = "/project/ANGEL/shared/Pipeline_test2/Data/CellBender_results"
    seurat_results        = "/project/ANGEL/shared/Pipeline_test2/Data/Seurat_results"
    anndata_results       = "/project/ANGEL/shared/Pipeline_test2/Data/AnnData_results"

    transcriptome         = "/databank/10x-rangers/refdata-gex-GRCh38-2020-A"
    ref_fasta             = "/databank/10x-rangers/refdata-gex-GRCh38-2020-A/fasta/genome.fa"
    common_variants       = "/project/ANGEL/shared/Pipeline/resources/common_variants_grch38.fixed.vcf"

    // Container images — pinned tags, pulled once into ${projectDir}/containers.
    // Bump deliberately; the .manifest next to each SIF records the digest pulled.
    cellbender_container  = "docker://us.gcr.io/broad-dsde-methods/cellbender:0.3.2"
    souporcell_container  = "docker://cumulusprod/souporcell:2021.03"
    seurat_container      = "docker://satijalab/seurat:5.5.1"
    scanpy_container      = "docker://gcfntnu/scanpy:1.12.3"

    // Bind mounts for Apptainer/Singularity on the lab cluster
    container_binds       = "/ceph,/project,/ceph-fast/databank:/databank"

    logs_dir              = "${projectDir}/logs"
}


// Slurm poller. The task monitor runs `squeue` to refresh job states; a slow
// controller response can block it indefinitely (seen 2026-10-19: monitor went
// silent at 20:22 with 14 jobs active, never recovered). Poll less often and
// be more patient with .exitcode files on NFS.
executor {
    name              = 'slurm'
    queueStatInterval = '5 min'
    pollInterval      = '2 min'
    exitReadTimeout   = '30 min'
    submitRateLimit   = '10/1min'
    queueSize         = 50
}

process {
    executor       = 'slurm'
    queue          = 'short'
    cpus           = 8
    memory         = '48 GB'
    time           = '24h'
    errorStrategy  = 'retry'
    maxRetries     = 2

    clusterOptions = '--mail-type=BEGIN,END,FAIL --mail-user=kristian.gurashi@ndcls.ox.ac.uk'

    withLabel: 'long' {
        queue  = 'long'
        cpus   = 16
        memory = '96 GB'
        time   = '144h'
    }

    withLabel: 'basic' {
        queue  = 'short'
        cpus   = 1
        memory = '1 GB'
        time   = '8h'
    }

    withLabel: 'build' {
        queue  = 'short'
        cpus   = 4
        memory = '16 GB'
        time   = '8h'
    }

    withLabel: 'gpu' {
        queue          = 'gpu'
        cpus           = 4
        memory         = '24 GB'
        time           = '24h'
        clusterOptions = '--mail-type=BEGIN,END,FAIL --mail-user=kristian.gurashi@ndcls.ox.ac.uk --gres=gpu:1'
    }
}

// Execution reports
report {
    enabled   = true
    file      = "${projectDir}/reports/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${projectDir}/reports/timeline.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${projectDir}/reports/trace.txt"
    overwrite = true
}